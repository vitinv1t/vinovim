# Metadata provider — TMDB
# Create an API key/token in your TMDB account. Keep the real value server-side only.
TMDB_READ_ACCESS_TOKEN=replace-with-tmdb-read-access-token
# Alternative to TMDB_READ_ACCESS_TOKEN:
# TMDB_API_KEY=replace-with-tmdb-v3-api-key

# Streaming availability — optional, non-commercial plan requires attribution.
WATCHMODE_API_KEY=replace-with-watchmode-api-key
WATCHMODE_REGIONS=PT
