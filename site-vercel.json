{
  "installCommand": "echo sem-dependencias",
  "buildCommand": "echo pronto",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/downloads.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/downloads/(.*)", "headers": [{ "key": "Content-Disposition", "value": "attachment" }, { "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/downloads/(.*).apk", "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }] }
  ]
}
